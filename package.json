{
  "name": "react-native-modalkit",
  "version": "0.2.0",
  "description": "A modern, Reanimated-first, fully-customizable Modal for React Native — drop-in replacement for react-native-modal with imperative API, gesture v2 swipes, and built-in stacking.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "react-native": "src/index.ts",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "CHANGELOG.md",
    "!src/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kuraydev/react-native-modalkit.git"
  },
  "author": "FreakyCoder <kurayogun@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/kuraydev/react-native-modalkit#readme",
  "bugs": {
    "url": "https://github.com/kuraydev/react-native-modalkit/issues"
  },
  "keywords": [
    "react-native",
    "modal",
    "react-native-modal",
    "modalkit",
    "reanimated",
    "gesture-handler",
    "bottom-sheet",
    "dialog",
    "swipe",
    "animated",
    "typescript"
  ],
  "scripts": {
    "build": "bob build",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run typecheck && npm run lint:ci && npm test && npm run build",
    "lint": "oxlint --deny-warnings src",
    "lint:ci": "oxlint --deny-warnings src",
    "format": "oxfmt src",
    "format:ci": "oxfmt --check src"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-native": ">=0.78.0",
    "react-native-gesture-handler": ">=2.16.0",
    "react-native-reanimated": ">=3.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@react-native/babel-preset": "^0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.2.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "react": "19.2.3",
    "react-native": "^0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-reanimated": "^4.5.3",
    "react-native-worklets": "^0.11.4",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --deny-warnings",
      "oxfmt"
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native/.*|@react-native-community/.*|@testing-library|react-native-reanimated|react-native-worklets|react-native-gesture-handler)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.types.ts",
      "!src/**/index.ts",
      "!src/types/**"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  }
}
